{
  "routing": {
    "maxRouteAttempts": 6,
    "_comment": "Automatic inference routing is owned by the compiled machine endpoint router. Project-local providers are explicit compatibility CLI backends only; they are never an automatic fallback."
  },
  "providers": {
    "codex": {
      "type": "cli",
      "command": "codex",
      "args": [
        "exec"
      ],
      "mode": "stdin",
      "disabled": false
    },
    "claude": {
      "type": "cli",
      "command": "claude",
      "args": [
        "-p"
      ],
      "mode": "stdin",
      "disabled": false
    },
    "agy": {
      "type": "cli",
      "command": "agy",
      "args": [
        "--mode",
        "accept-edits"
      ],
      "mode": "stdin",
      "disabled": false
    },
    "opencode": {
      "type": "cli",
      "command": "opencode",
      "args": [
        "run"
      ],
      "mode": "stdin",
      "disabled": false
    }
  },
  "maxConcurrent": 3,
  "autofillEnabled": true,
  "autofillIntervalSeconds": 300,
  "workingSetBudgetChars": 24000,
  "maxFileChars": 8000,
  "dependencyResultBudgetChars": 8000,
  "recentEventCount": 12,
  "recentEventBudgetChars": 4000,
  "stagnationWarningThreshold": 2,
  "requireHumanApprovalForPlan": true,
  "validatorEnabled": true,
  "projectReviewEveryTasks": 5,
  "projectReviewAfterMultiMerge": true,
  "projectReviewerEnabled": true,
  "projectValidateCommand": null,
  "projectValidateTimeoutSeconds": 600,
  "mcp": {
    "allowHumanAuthorityTools": false
  }
}
