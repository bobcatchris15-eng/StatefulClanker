{
  "routing": {
    "maxRouteAttempts": 6,
    "_comment": "Automatic inference routing is owned by the compiled machine endpoint router. Project-local providers are explicit compatibility CLI backends only; they are never an automatic fallback."
  },
  "providers": {
    "codex": {
      "type": "cli",
      "command": "codex",
      "args": [
        "exec"
      ],
      "mode": "stdin",
      "disabled": false
    },
    "claude": {
      "type": "cli",
      "command": "claude",
      "args": [
        "-p"
      ],
      "mode": "stdin",
      "disabled": false
    },
    "agy": {
      "type": "cli",
      "command": "agy",
      "args": [
        "--mode",
        "accept-edits"
      ],
      "mode": "stdin",
      "disabled": false
    },
    "opencode": {
      "type": "cli",
      "command": "opencode",
      "args": [
        "run"
      ],
      "mode": "stdin",
      "disabled": false
    }
  },
  "maxConcurrent": 3,
  "autofillEnabled": true,
  "autofillIntervalSeconds": 300,
  "workingSetBudgetChars": 24000,
  "maxFileChars": 8000,
  "dependencyResultBudgetChars": 8000,
  "recentEventCount": 12,
  "recentEventBudgetChars": 4000,
  "stagnationWarningThreshold": 2,
  "requireHumanApprovalForPlan": true,
  "validatorEnabled": true,
  "projectReviewEveryTasks": 5,
  "projectReviewAfterMultiMerge": true,
  "projectReviewerEnabled": true,
  "projectValidateCommand": null,
  "projectValidateTimeoutSeconds": 600,
  "mcp": {
    "allowHumanAuthorityTools": false
  },
  "validation": {
    "mechanicalTimeoutSeconds": 300,
    "mechanicalOutputChars": 12000,
    "preferJev": true,
    "jevBaseUrl": "https://api.typesafe.ai",
    "jevModel": "jev-latest",
    "jevApiKeyEnv": "TYPESAFE_API_KEY",
    "jevTimeoutSeconds": 20,
    "jevPassThreshold": 0.9,
    "jevFailThreshold": 0.1,
    "_comment": "Tasks with check commands use deterministic acceptance first. Passing mechanical-only tasks need no inference. judge criteria prefer TypeSafe Jev when TYPESAFE_API_KEY is available; unavailable or uncertain Jev decisions fall back to the ordinary routed validator."
  }
}
