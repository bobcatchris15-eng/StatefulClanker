    },
    "claude": {
      "type": "cli",
      "command": "claude",
      "args": ["-p"],
      "mode": "stdin",
      "priority": 2,
      "disabled": false
    },
    "agy": {
      "type": "cli",
      "command": "agy",
      "args": ["--mode", "accept-edits"],
