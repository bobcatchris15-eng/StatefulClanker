{
  "routing": {
    "maxRouteAttempts": 6,
    "_comment": "Automatic worker/validator routing plus project-review routing uses .statefulclanker/routing/target-pool.json with persistent pseudo-round-robin over healthy rows. Configured providers are a migration/CLI fallback only when the target pool is empty. Explicit -Provider remains a strict operator/debug override."
  },
  "providers": {
    "codex": {
      "type": "cli",
      "command": "codex",
      "args": [
        "exec"
      ],
      "mode": "stdin",
      "disabled": false
    },
    "claude": {
      "type": "cli",
      "command": "claude",
      "args": [
        "-p"
      ],
      "mode": "stdin",
      "disabled": false
    },
    "agy": {
      "type": "cli",
      "command": "agy",
      "args": [
        "--mode",
        "accept-edits"
      ],
      "mode": "stdin",
      "disabled": false
    },
    "opencode": {
      "type": "cli",
      "command": "opencode",
      "args": [
        "run"
      ],
      "mode": "stdin",
      "disabled": false
    }
  },
  "maxConcurrent": 3,
  "autofillEnabled": true,
  "autofillIntervalSeconds": 300,
  "workingSetBudgetChars": 24000,
  "maxFileChars": 8000,
  "dependencyResultBudgetChars": 8000,
  "recentEventCount": 12,
  "recentEventBudgetChars": 4000,
  "stagnationWarningThreshold": 2,
  "requireHumanApprovalForPlan": true,
  "criticEnabled": false,
  "validatorEnabled": true,
  "projectReviewEveryTasks": 5,
  "projectReviewAfterMultiMerge": true,
  "projectCriticEnabled": true,
  "projectValidatorEnabled": true,
  "projectValidateCommand": null,
  "projectValidateTimeoutSeconds": 600,
  "projectReviewRemediationTask": true,
  "mcp": {
    "allowHumanAuthorityTools": false
  },
  "perTaskReviewPolicy": "validator-only; criticEnabled is retained for legacy config compatibility and is not an ordinary task gate",
  "defaultProvider": null,
  "criticProvider": null,
  "validatorProvider": null
}
