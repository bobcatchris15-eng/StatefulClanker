{
  "defaultProvider": "opencode",
  "criticProvider": null,
  "validatorProvider": null,
  "providers": {
    "claude": {
      "command": "claude",
      "args": [
        "-p"
      ],
      "mode": "stdin"
    },
    "agy": {
      "command": "agy",
      "args": [
        "--mode",
        "accept-edits"
      ],
      "mode": "stdin"
    },
    "opencode": {
      "command": "opencode",
      "args": [
        "run"
      ],
      "mode": "stdin"
    }
  },
  "maxConcurrent": 3,
  "workingSetBudgetChars": 24000,
  "maxFileChars": 8000,
  "dependencyResultBudgetChars": 8000,
  "recentEventCount": 12,
  "recentEventBudgetChars": 4000,
  "stagnationWarningThreshold": 2,
  "requireHumanApprovalForPlan": true,
  "criticEnabled": true,
  "validatorEnabled": true,
  "projectReviewEveryTasks": 5,
  "projectReviewAfterMultiMerge": true,
  "projectCriticEnabled": true,
  "projectValidatorEnabled": true,
  "projectValidateCommand": null,
  "projectValidateTimeoutSeconds": 600,
  "projectReviewRemediationTask": true
}
