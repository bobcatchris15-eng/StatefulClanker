{
  "name": "statefulclanker",
  "version": "1.2.0",
  "description": "Pi package orchestrating native Pi, OpenCode, Antigravity and Jules REST coding workers",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobcatchris15-eng/StatefulClanker.git"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "operator.ts",
    "worker.ts",
    "catalog",
    "pools",
    "protocol",
    "context",
    "project",
    "ui",
    "workers",
    "workspace",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts",
    "e2e": "node --test tests/e2e/*.test.ts",
    "validate": "npm run typecheck && npm test && npm run e2e"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^24.0.0",
    "typebox": "*",
    "typescript": "^5.9.0"
  }
}
